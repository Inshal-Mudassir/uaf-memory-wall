# ---- Copy to .env for local development. Never commit the real .env file. ----

APP_ENV=development            # set to "production" when deployed

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=uaf_memory_wall

# Cloudinary (Dashboard > Settings > API Keys). The secret stays on the server only.
STORAGE_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=uaf-memory-wall

# Comma-separated list of frontend origins allowed to call the API (no trailing slash)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Long random string. Used to hash visitor ids for likes and reports. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_SALT=

# Moderation key for /admin. Leave empty to disable moderation endpoints.
ADMIN_API_KEY=

# true when running behind a proxy such as Render, so the real visitor IP is used for rate limits
TRUST_PROXY=true

# Optional: comma-separated words that are not allowed in memories or comments
BLOCKED_WORDS=

# Number of different visitors who must report an item before it is hidden automatically
REPORT_HIDE_THRESHOLD=3

# Upload limits
MAX_IMAGE_MB=8
MAX_IMAGES=6

# Rate limits (requests per window in seconds, per visitor). Defaults shown.
# RATE_POST_LIMIT=5          RATE_POST_WINDOW=3600
# RATE_COMMENT_LIMIT=10      RATE_COMMENT_WINDOW=600
# RATE_LIKE_LIMIT=60         RATE_LIKE_WINDOW=600
# RATE_REPORT_LIMIT=10       RATE_REPORT_WINDOW=3600

# ---- Local-only shortcuts (no Atlas or Cloudinary account needed). Not allowed in production. ----
# USE_MOCK_DB=true
# SEED_DEMO_ON_START=true     # adds clearly-labelled demo memories to the mock database
# STORAGE_BACKEND=local
# PUBLIC_BASE_URL=http://localhost:8000
